    <rdf:Bag>
     <rdf:li
      photoshop:LayerName="Aceptar la vida como un regalo y ver como  de los escombros  na"
      photoshop:LayerText="Aceptar la vida como un regalo y ver como  de los escombros  nace una nueva oportunidad, nos recuerda que es el tiempo del abrazo y momento del cambio de conciencia que como magia, nace de la fusi√≥n de un beso.   No es tiempo de rencores ni egos inflados, este es el momento de darnos un abrazo y levantar la voz, de comulgar con ese sentir de supervivencia que busca un giro en la humanidad."/>
     <rdf:li
      photoshop:LayerName="El agua"
      photoshop:LayerText="El agua"/>
     <rdf:li
      photoshop:LayerName="¬°todos"
