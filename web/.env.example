# Copiar a .env.local si hace falta. NUNCA comitear .env.local ni service-account.json.
#
# Local: basta con poner service-account.json en la RAÍZ del repo (cali-rivera/service-account.json, git-ignored).
# Netlify: `npm run firebase:netlify-env` genera ../netlify.env con estas 3 variables (caben en el límite de 4 KB):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa: el JSON completo (o en base64) en una sola variable
FIREBASE_SERVICE_ACCOUNT=
# Opcional: bucket de Storage (por defecto <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

ADMIN_EMAIL=arte@calirivera.com
# Otros correos que también pueden entrar al editor (separados por coma), p. ej. el de Oriens.ninja.
# Cada uno pide su propio código en /admin/entrar y le llega solo a su correo.
EDITOR_EMAILS=
NEXT_PUBLIC_SITE_URL=https://calirivera.com

# ---------- CMS (rama 4) ----------
# Firma la sesión del editor y las HMAC de códigos/IPs. Mínimo 32 caracteres: `npm run cms:secret`
SESSION_SECRET=
# Correo que envía el código de acceso (buzón de calirivera.com en Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=arte@calirivera.com
SMTP_PASS=
SMTP_FROM="Cali Rivera <arte@calirivera.com>"
# Dónde se guarda el CONTENIDO que edita Cali (CMS_STORE=github|firestore|local; si no se pone, se elige solo):
#   - con service account de Firebase → Firestore (cambios al instante)
#   - sin Firebase y con GITHUB_TOKEN + GITHUB_REPO → el repo (gratis: cada «Publicar» es un commit y Netlify
#     reconstruye el sitio en 2–4 min; el editor muestra el avance). Ver docs/EDITOR.md
CMS_STORE=
# Opcional: estado exacto de cada despliegue en el editor (si falta, se deduce comparando commits)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# Dónde se guardan las fotos que sube Cali: github (default si hay token) | firebase (requiere plan Blaze) | local (dev)
MEDIA_STORE=github
# Token fine-grained con permiso "Contents: Read and write" SOLO sobre este repo
GITHUB_TOKEN=
GITHUB_REPO=usuario/cali-rivera
GITHUB_BRANCH=main
# Carpeta pública dentro del repo (Netlify base = web)
GITHUB_PUBLIC_DIR=web/public
