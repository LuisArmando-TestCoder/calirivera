# Copiar a .env.local si hace falta. NUNCA comitear .env.local ni service-account.json.
#
# Local: basta con poner service-account.json en la RAÍZ del repo (cali-rivera/service-account.json, git-ignored).
# Netlify: `npm run firebase:netlify-env` genera ../netlify.env con estas 3 variables (caben en el límite de 4 KB):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa: el JSON completo (o en base64) en una sola variable
FIREBASE_SERVICE_ACCOUNT=
# Opcional: bucket de Storage (por defecto <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

ADMIN_EMAIL=arte@calirivera.com
NEXT_PUBLIC_SITE_URL=https://calirivera.com
