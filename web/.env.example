# Copiar a .env.local. NUNCA comitear .env.local ni .secrets/.
# Servidor: JSON del service account (o base64). Alternativa local: .secrets/service-account.json
FIREBASE_SERVICE_ACCOUNT=
ADMIN_EMAIL=arte@calirivera.com
NEXT_PUBLIC_SITE_URL=https://calirivera.com

# Cliente (Firebase web app config) — solo si el CMS usa el SDK de cliente
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
